---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const PAGE_SIZE = 6;

const page = Number(Astro.url.searchParams.get('page') || 1);

const posts = await getCollection('blog');

// ordenar
posts.sort((a, b) =>
  new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

// paginación dinámica
const start = (page - 1) * PAGE_SIZE;
const paginated = posts.slice(start, start + PAGE_SIZE);

const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---

<BlogLayout frontmatter={{ title: "HacksFinancierosMX" }}>

  <h1 class="title"><img src="/images/letraslogo.png" alt="HacksFinancierosMX" /></h1>

  <div class="grid">
    {paginated.map(post => (
      <a class="card" href={`/blog/${post.id}`}>

        <!-- 🖼 imagen -->
        <div class="image">
          <img src={post.data.image || "/images/default.png"} alt="" />
        </div>

        <!-- 🧠 contenido -->
        <div class="content">
          <span class="tag">
            {post.id.split('/')[0]}
          </span>

          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </div>

      </a>
    ))}
  </div>

  <!-- 🔢 paginación -->
  <div class="pagination">
    {Array.from({ length: totalPages }).map((_, i) => (
      <a
        class={i + 1 === page ? "active" : ""}
        href={`/?page=${i + 1}`}
      >
        {i + 1}
      </a>
    ))}
  </div>

</BlogLayout>

