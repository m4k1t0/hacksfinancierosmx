---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const PAGE_SIZE = 6;

const page = Number(Astro.url.searchParams.get('page') || 1);

const posts = await getCollection('blog');

// ordenar
posts.sort((a, b) =>
  new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

// paginación dinámica
const start = (page - 1) * PAGE_SIZE;
const paginated = posts.slice(start, start + PAGE_SIZE);

const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---

<BlogLayout frontmatter={{ title: "HacksFinancierosMX" }}>

  <h1 class="title">HacksFinancierosMX</h1>

  <div class="grid">
    {paginated.map(post => (
      <a class="card" href={`/blog/${post.id}`}>

        <!-- 🖼 imagen -->
        <div class="image">
          <img src={post.data.image || "/images/default.jpg"} alt="" />
        </div>

        <!-- 🧠 contenido -->
        <div class="content">
          <span class="tag">
            {post.id.split('/')[0]}
          </span>

          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </div>

      </a>
    ))}
  </div>

  <!-- 🔢 paginación -->
  <div class="pagination">
    {Array.from({ length: totalPages }).map((_, i) => (
      <a
        class={i + 1 === page ? "active" : ""}
        href={`/?page=${i + 1}`}
      >
        {i + 1}
      </a>
    ))}
  </div>

</BlogLayout>

<style>
.title {
  margin-bottom: 2rem;
}

/* GRID */
.grid {
  display: grid;
  gap: 2rem;
}

/* CARD */
.card {
  display: block;
  border-radius: 16px;
  overflow: hidden;
  background: #0f172a;
  border: 1px solid #1e293b;
  transition: all 0.25s ease;
}

/* hover con vida */
.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  border-color: #3b82f6;
}

/* imagen */
.image {
  height: 180px;
  overflow: hidden;
}

.image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* contenido */
.content {
  padding: 1.2rem;
}

.tag {
  font-size: 0.7rem;
  color: #60a5fa;
  text-transform: uppercase;
}

/* título */
.card h2 {
  margin: 0.5rem 0;
  color: #f8fafc;
  font-size: 1.2rem;
}

/* descripción */
.card p {
  margin: 0;
  color: #94a3b8;
}

/* paginación */
.pagination {
  margin-top: 2rem;
  display: flex;
  gap: 0.5rem;
}

.pagination a {
  padding: 0.5rem 0.8rem;
  background: #1e293b;
  border-radius: 8px;
  color: #cbd5f5;
}

.pagination a.active {
  background: #3b82f6;
  color: white;
}
</style>