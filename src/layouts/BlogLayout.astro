---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// categorías dinámicas (nivel 1)
const categories = [...new Set(
  posts.map(post => post.id.split('/')[0])
)];
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>HacksFinancierosMX</title>

  <style>
/* ===== RESET ===== */
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family: system-ui, sans-serif;
  background: radial-gradient(circle at top, #0f172a, #020617);
  color:#f8fafc;
}
a{text-decoration:none;color:inherit}

/* ===== NAVBAR PRO ===== */
header{
  position:sticky;
  top:0;
  z-index:10;
  backdrop-filter: blur(10px);
  background: rgba(2,6,23,0.85);
  border-bottom:1px solid rgba(255,255,255,0.06);
}

/* contenedor */
.nav{
  max-width:1100px;
  margin:auto;
  padding:0.8rem 1rem;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

/* logo */
.brand{
  font-weight:700;
  font-size:1rem;
  letter-spacing:-0.02em;
}

/* menu desktop */
.menu{
  display:flex;
  gap:0.6rem;
}

/* botones */
.menu a{
  font-size:0.85rem;
  padding:0.35rem 0.7rem;
  border-radius:999px;
  color:#94a3b8;
  transition:0.2s;
}

.menu a:hover{
  background:#0f172a;
  color:#38bdf8;
}

/* botón móvil */
.toggle{
  display:none;
  background:none;
  border:none;
  color:#94a3b8;
  font-size:1.2rem;
}

/* ===== MOBILE ===== */
@media(max-width:700px){

  .toggle{
    display:block;
  }

  .menu{
    position:absolute;
    top:60px;
    left:0;
    right:0;
    background:#020617;
    border-top:1px solid #1e293b;
    flex-direction:column;
    padding:1rem;
    display:none;
  }

  .menu.active{
    display:flex;
  }

  .menu a{
    padding:0.6rem;
    border-radius:8px;
  }
}

/* ===== MAIN ===== */
main{
  max-width:1100px;
  margin:auto;
  padding:2rem 1rem;
}

/* ===== TITLE ===== */
.title{
  font-size:2.2rem;
  margin-bottom:2rem;
}

/* ===== GRID ===== */
.grid{
  display:grid;
  gap:1.6rem;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
}

/* ===== CARD PRO ===== */
.card{
  display:block;
  border-radius:18px;
  overflow:hidden;
  background: linear-gradient(145deg,#0f172a,#020617);
  border:1px solid rgba(255,255,255,0.06);
  transition:0.25s ease;
  position:relative;
}

/* glow */
.card::after{
  content:"";
  position:absolute;
  inset:0;
  background: radial-gradient(circle at 20% 0%, rgba(56,189,248,0.25), transparent 60%);
  opacity:0;
  transition:0.3s;
}

.card:hover{
  transform:translateY(-6px) scale(1.01);
  border-color:rgba(56,189,248,0.4);
  box-shadow:0 20px 60px rgba(0,0,0,0.6);
}

.card:hover::after{
  opacity:1;
}

/* ===== IMAGE ===== */
.image{
  height:150px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#020617;
}

.image.cover img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:0.4s;
}

.card:hover .image.cover img{
  transform:scale(1.05);
}

.image.logo img{
  max-height:70px;
  max-width:80%;
  object-fit:contain;
}

/* ===== CONTENT ===== */
.content{
  padding:1rem 1.2rem;
}

.tag{
  font-size:0.65rem;
  color:#38bdf8;
  margin-bottom:0.4rem;
  display:block;
}

/* ===== TEXT ===== */
.card h3{
  font-size:1.05rem;
  margin-bottom:0.3rem;
}

.card p{
  font-size:0.9rem;
  color:#94a3b8;
}

/* ===== MARKDOWN ===== */
article{
  max-width:720px;
}

article p{
  color:#cbd5f5;
  line-height:1.7;
}

article h2{
  margin-top:2rem;
}

/* ===== PAGINATION ===== */
.pagination{
  margin-top:2rem;
  display:flex;
  gap:0.5rem;
}

.pagination a{
  padding:0.5rem 0.8rem;
  background:#0f172a;
  border-radius:8px;
  color:#cbd5f5;
}

.pagination a.active{
  background:#38bdf8;
  color:white;
}
  </style>
</head>

<body>

<header>
  <div class="nav">
    <a class="brand" href="/">HacksFinancierosMX</a>

    <button class="toggle" onclick="document.querySelector('.menu').classList.toggle('active')">
      ☰
    </button>

    <nav class="menu">
      {categories.map(cat => (
        <a href={`/${cat}`}>{cat}</a>
      ))}
    </nav>
  </div>
</header>

<main>
  <slot />
</main>

</body>
</html>