---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = await getCollection('blog');

const categories = [...new Set(
  posts.map(post => post.id.split('/')[0])
)];

const current = Astro.url.pathname.split('/')[1] || '';

// formato bonito
const format = (str) =>
  str.charAt(0).toUpperCase() + str.slice(1);
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>HacksFinancierosMX</title>

  <!-- SEO -->
  <meta name="description" content="Optimiza tu dinero en México con estrategias reales de tarjetas, cashback y ahorro." />
  <meta property="og:title" content="HacksFinancierosMX" />
  <meta property="og:description" content="Estrategias financieras reales en México" />
  <meta property="og:image" content="/images/logo.png" />

  <!-- FAVICON -->
  <link rel="icon" href="/images/logo.png" />
</head>

<body>

<header>
  <div class="nav">

    <a class="brand" href="/">
      <img src="/images/logo.png" alt="logo" />

    </a>

    <button class="toggle" onclick="document.querySelector('.menu').classList.toggle('active')">
      ☰
    </button>

    <nav class="menu">
      {categories.map(cat => (
        <a
          class={current === cat ? "active" : ""}
          href={`/${cat}`}>
          {format(cat)}
        </a>
      ))}
    </nav>

  </div>
</header>

<main>
  <slot />
</main>

</body>
</html>